; ============================================
; Dr.COM 4.0 校园网一键登录 - 配置文件模板
;
; 请将本文件复制为 drcom.conf 后填写，
; 或直接运行 setup_first_login.bat 自动生成。
;
; 放置位置（按优先级）:
;   1. 环境变量 DRCOM_CONF 指定路径
;   2. 程序所在目录
;   3. 当前工作目录
;
; ⚠ drcom.conf 中含明文密码，请勿分享或提交到仓库。
; ============================================

; ---------- 账号信息（必填） ----------
username = 2025xxxxxx
password = your_password
suffix   = unicom

; ---------- 服务器配置（可选，一般无需修改） ----------
; 留空或删除则使用程序内置默认值
server        = 10.0.100.3
port_http     = 80
port_portal   = 801
ac_name       = ME60-CSDX
js_version    = 4.2.1
terminal_type = 1
